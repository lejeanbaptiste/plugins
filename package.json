{
  "name": "ljb-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Optional plugins for Le Jean-Baptiste (LJB)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate": "node packages/plugin-sdk/validate-all.mjs",
    "release": "npm run build:cjk-dates && npm run build:norbert && node scripts/build-release.mjs",
    "build:cjk-dates": "npm run build -w @ljb/plugin-cjk-dates",
    "build:norbert": "npm run build -w @ljb/plugin-norbert",
    "build:kanripo-import": "npm run build -w @ljb/plugin-kanripo-import",
    "build:concordance": "npm run build:concordance -w @ljb/plugin-kanripo-import",
    "build:kanripo-metadata": "npm run build:metadata -w @ljb/plugin-kanripo-import",
    "build:daozang-import": "npm run build -w @ljb/plugin-daozang-import",
    "build:daozang-corpus": "npm run build:corpus-data -w @ljb/plugin-daozang-import",
    "build:daozang-metadata": "npm run build:metadata -w @ljb/plugin-daozang-import",
    "smoke:cjk-dates": "npm run smoke -w @ljb/plugin-cjk-dates",
    "smoke:norbert": "npm run smoke -w @ljb/plugin-norbert",
    "smoke:kanripo-import": "npm run smoke -w @ljb/plugin-kanripo-import",
    "smoke:daozang-import": "npm run smoke -w @ljb/plugin-daozang-import",
    "test": "node --test 'packages/**/*.test.mjs'"
  },
  "license": "GPL-2.0"
}
