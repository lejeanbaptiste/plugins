{
  "name": "ljb-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Optional plugins for Le Jean-Baptiste (LJB)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate": "node packages/plugin-sdk/validate-all.mjs",
    "build:cjk-dates": "npm run build -w @ljb/plugin-cjk-dates",
    "smoke:cjk-dates": "npm run smoke -w @ljb/plugin-cjk-dates",
    "test": "node --test 'packages/**/*.test.mjs'"
  },
  "license": "GPL-2.0"
}
